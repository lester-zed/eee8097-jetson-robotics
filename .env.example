# Copy this file to .env and replace the placeholders with paths from:
#   ls -l /dev/serial/by-id/
#
# .env is intentionally ignored because these values are machine-specific.
ROARM_DEVICE=/dev/serial/by-id/REPLACE_WITH_ROARM_DEVICE_ID
RPLIDAR_DEVICE=/dev/serial/by-id/REPLACE_WITH_RPLIDAR_DEVICE_ID
CAMERA_DEVICE=/dev/video0
